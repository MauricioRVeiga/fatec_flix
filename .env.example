# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External API
UPSTREAM_API_URL=https://api.reidoscanais.st

# Cron
CRON_SECRET=

# Login — único e-mail autorizado a acessar o site inteiro (não só
# /admin), mesmo que outros usuários existam/se cadastrem no projeto
# Supabase Auth.
ADMIN_EMAIL=

# Features
NEXT_PUBLIC_ENABLE_EXTERNAL_EMBEDS=false

# E2E (opcional) — senha real da conta ADMIN_EMAIL, só pra
# tests/e2e/global-setup.ts logar sozinho antes da suíte Playwright.
# NUNCA lida pela aplicação em si (nenhum app/lib importa isto) — só
# necessária localmente pra rodar `npm run test:e2e`. Não existe no CI
# (o workflow não roda E2E).
E2E_ADMIN_PASSWORD=
