# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca versionar segredos reais, mas .env.example é só
# um template com valores vazios e precisa ser versionado (documenta
# as variáveis exigidas, ver README > Variáveis de ambiente)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local link cache — contém a connection string do
# Postgres (com senha) do projeto linkado, nunca deve ir para o git
supabase/.temp

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
